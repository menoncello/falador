{
  "name": "falador",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test packages/",
    "test:coverage": "bun test packages/ --coverage",
    "test:mutate": "stryker run",
    "test:mutate:report": "stryker run --reporters html,dashboard",
    "turbo:mutate": "bun turbo run test:mutate",
    "turbo:mutate:report": "bun turbo run test:mutate:report",
    "test:e2e": "node --experimental-vm-modules node_modules/.bin/playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report test-results/html",
    "test:api": "playwright test --project=api",
    "test:performance": "k6 run tests/performance/auth-load-test.js",
    "test:performance:smoke": "k6 run tests/performance/auth-smoke-test.js",
    "test:performance:baseline": "k6 run tests/performance/auth-smoke-test.js --out json=performance-baseline.json",
    "quality-gates": "bun run typecheck && bun run lint && bun run format:check && bun test && bun run test:mutate",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@faker-js/faker": "^10.1.0",
    "@playwright/test": "^1.49.1",
    "@stryker-mutator/core": "^9.2.0",
    "@stryker-mutator/typescript-checker": "^9.2.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^24.8.1",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "c8": "10.1.3",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^61.1.4",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-unicorn": "^61.0.2",
    "husky": "^9.0.0",
    "lint-staged": "^16.2.4",
    "prettier": "^3.5.3",
    "turbo": "2.5.8",
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2"
  }
}
