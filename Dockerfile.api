# Multi-stage Dockerfile for Falador API Gateway
# Optimized for Bun runtime and production deployment

# Stage 1: Dependencies
FROM oven/bun:1.3 AS deps
WORKDIR /app

# Copy package files
COPY package.json bun.lock ./
COPY packages/api-gateway/package.json ./packages/api-gateway/

# Install dependencies (production only)
RUN bun install --frozen-lockfile --production

# Stage 2: Builder
FROM oven/bun:1.3 AS builder
WORKDIR /app

# Copy dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages/api-gateway/node_modules ./packages/api-gateway/node_modules

# Copy source code
COPY . .

# Build TypeScript code
RUN bun run typecheck
RUN bun build packages/api-gateway/src/index.ts --outdir packages/api-gateway/dist --target bun

# Stage 3: Production runtime
FROM oven/bun:1.3-slim AS runtime
WORKDIR /app

# Set production environment
ENV NODE_ENV=production
ENV PORT=3000

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 bunuser

# Copy necessary files
COPY --from=deps --chown=bunuser:nodejs /app/node_modules ./node_modules
COPY --from=deps --chown=bunuser:nodejs /app/packages/api-gateway/node_modules ./packages/api-gateway/node_modules
COPY --from=builder --chown=bunuser:nodejs /app/packages/api-gateway/dist ./packages/api-gateway/dist
COPY --from=builder --chown=bunuser:nodejs /app/packages/api-gateway/package.json ./packages/api-gateway/

# Switch to non-root user
USER bunuser

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD bun run --bun /app/packages/api-gateway/dist/index.js || exit 1

# Start application
CMD ["bun", "run", "--bun", "/app/packages/api-gateway/dist/index.js"]
