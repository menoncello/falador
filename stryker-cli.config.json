{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "CLI Only - Mutation Testing Configuration",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "bun test packages/cli/"
  },
  "mutate": ["packages/cli/**/*.ts", "!**/*.test.ts", "!**/*.spec.ts"],
  "thresholds": {
    "high": 80,
    "low": 70,
    "break": 80
  },
  "coverageAnalysis": "perTest",
  "reporters": ["html", "clear-text", "progress"],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation-report-cli.html"
  },
  "timeoutMS": 60000,
  "concurrency": 4,
  "mutator": {
    "plugins": ["@stryker-mutator/typescript-checker"],
    "excludedMutations": []
  }
}
