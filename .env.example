# Test Environment Configuration
# Copy this file to .env and fill in the values

# Environment
TEST_ENV=local

# API Configuration
BASE_URL=http://localhost:3000
API_URL=http://localhost:3000/api

# Database Configuration (for integration tests)
DATABASE_URL=postgresql://falador:dev_password@localhost:5432/falador_test

# Redis Configuration (for queue tests)
REDIS_URL=redis://localhost:6379

# Authentication (test user credentials)
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=TestPassword123!
TEST_API_KEY=

# TTS Configuration (for KokoroTTS integration tests)
KOKORO_API_KEY=
KOKORO_API_URL=http://localhost:8000

# Storage Configuration (for file upload/download tests)
GCS_BUCKET_NAME=falador-test-bucket
GCS_PROJECT_ID=falador-test
# GCS_KEY_FILE=./config/gcs-test-key.json

# Feature Flags (optional)
FEATURE_FLAG_CHAPTER_SPLITTING=true
FEATURE_FLAG_VOICE_CLONING=false

# Test Timeouts (milliseconds)
TEST_TIMEOUT=60000
API_TIMEOUT=30000
TTS_TIMEOUT=120000

# Logging
LOG_LEVEL=debug
LOG_PRETTY=true

# CI/CD (set automatically in CI environment)
CI=false
