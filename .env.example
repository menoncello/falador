# Docker Development Environment Configuration
# Copy this file to .env and fill in the values for local development

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Node environment (development, production, test)
NODE_ENV=development

# Application port (default: 3000)
PORT=3000

# Logging level (error, warn, info, debug)
LOG_LEVEL=debug

# Enable pretty logging in development
LOG_PRETTY=true

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# =============================================================================

# PostgreSQL connection settings
POSTGRES_USER=falador
POSTGRES_PASSWORD=falador_dev
POSTGRES_DB=falador
POSTGRES_PORT=5432

# Full database URL (used by application)
DATABASE_URL=postgresql://falador:falador_dev@localhost:5432/falador

# Database connection pool settings
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUTMillis=30000
DATABASE_CONNECTION_TIMEOUTMillis=2000

# =============================================================================
# REDIS CONFIGURATION (Caching & Job Queue)
# =============================================================================

# Redis connection settings
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Redis connection pool settings
REDIS_POOL_MIN=1
REDIS_POOL_MAX=5

# Job queue configuration
JOB_QUEUE_CONCURRENCY=5
JOB_QUEUE_MAX_RETRIES=3
JOB_QUEUE_RETRY_DELAY=5000

# =============================================================================
# API GATEWAY CONFIGURATION
# =============================================================================

# API base URLs
API_URL=http://localhost:3000/api
BASE_URL=http://localhost:3000

# CORS settings
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# TTS SERVICE CONFIGURATION (KokoroTTS)
# =============================================================================

# KokoroTTS API settings
KOKORO_API_KEY=your_kokoro_api_key_here
KOKORO_API_URL=http://localhost:8000
KOKORO_TIMEOUT=120000

# TTS processing settings
TTS_MAX_FILE_SIZE_MB=50
TTS_SUPPORTED_FORMATS=mp3,wav,ogg
TTS_QUALITY=high

# =============================================================================
# STORAGE CONFIGURATION (Google Cloud Storage)
# =============================================================================

# GCS settings
GCS_PROJECT_ID=falador-dev
GCS_BUCKET_NAME=falador-dev-bucket
GCS_LOCATION=us-central1

# Local storage fallback
LOCAL_STORAGE_PATH=./storage
LOCAL_STORAGE_MAX_SIZE_GB=10

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================

# JWT settings
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# API key settings
API_KEY_HEADER=x-api-key
API_KEY_PREFIX=falador_

# Password security
BCRYPT_ROUNDS=12
SESSION_SECRET=your_session_secret_change_in_production

# =============================================================================
# DEVELOPMENT TOOLS CONFIGURATION
# =============================================================================

# pgAdmin settings (optional)
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@falador.local
PGADMIN_PASSWORD=admin

# Redis Commander settings (optional)
REDIS_COMMANDER_PORT=8081

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Feature flags for development
FEATURE_FLAG_CHAPTER_SPLITTING=true
FEATURE_FLAG_VOICE_CLONING=true
FEATURE_FLAG_BATCH_PROCESSING=true
FEATURE_FLAG_QUALITY_SCORING=true
FEATURE_FLAG_AI_DIRECTION=true

# =============================================================================
# DOCKER & BUILD CONFIGURATION
# =============================================================================

# Docker build optimization
DOCKER_BUILDKIT=1
BUILDKIT_INLINE_CACHE=1

# Build settings
TURBO_CACHE_DIR=.turbo
BUILD_PARALLEL=true

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================

# Health check settings
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_RETRIES=3

# Metrics (optional)
PROMETHEUS_PORT=9090
METRICS_ENABLED=false

# =============================================================================
# TESTING & QUALITY
# =============================================================================

# Test configuration
TEST_TIMEOUT=60000
API_TIMEOUT=30000
TTS_TIMEOUT=120000

# CI/CD detection
CI=false

# =============================================================================
# DEVELOPMENT NOTES
# =============================================================================

# This file is used for Docker Compose development environment.
# Variables with default values can be used as-is.
# Variables marked as "change in production" should be updated before deployment.
#
# To use this configuration:
# 1. Copy .env.docker.example to .env
# 2. Fill in any required API keys or secrets
# 3. Run: docker-compose up -d
# 4. Access services:
#    - Application: http://localhost:3000
#    - PostgreSQL: localhost:5432
#    - Redis: localhost:6379
#    - pgAdmin: http://localhost:5050 (if enabled with --profile tools)