{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "API Gateway - Mutation Testing Configuration",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "bun test"
  },
  "mutate": ["src/**/*.ts", "!src/**/*.test.ts", "!src/**/*.spec.ts"],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  },
  "coverageAnalysis": "perTest",
  "reporters": ["html", "clear-text", "progress"],
  "htmlReporter": {
    "fileName": "reports/mutation-report.html"
  },
  "timeoutMS": 60000,
  "concurrency": 4,
  "mutator": "@stryker-mutator/typescript",
  "typescriptChecker": {
    "excludedMutations": []
  }
}
