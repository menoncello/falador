{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "API Gateway - Optimized Mutation Testing Configuration",
  "packageManager": "bun",
  "testRunner": "command",
  "commandRunner": {
    "command": "bun test --timeout=20000"
  },
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts",
    "!src/test-factories.ts",
    "!src/database.test.ts",
    "!src/di-container.test.ts",
    "!src/routes/auth.test.ts",
    "!src/routes/projects.test.ts",
    "!src/index.test.ts"
  ],
  "thresholds": {
    "high": 85,
    "low": 75,
    "break": 80
  },
  "coverageAnalysis": "perTest",
  "reporters": ["html", "clear-text", "progress"],
  "htmlReporter": {
    "fileName": "reports/mutation-report.html"
  },
  "timeoutMS": 20000,
  "concurrency": 4,
  "maxConcurrentTestRunners": 2,
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "allowConsoleColors": true,
  "ignorePatterns": [
    "node_modules/**",
    "coverage/**",
    "dist/**",
    "**/*.min.js",
    "**/*.d.ts",
    "reports/**"
  ],
  "mutator": {
    "plugins": ["@stryker-mutator/typescript-checker"],
    "excludedMutations": [
      "StringLiteral",
      "ArrayLiteral"
    ],
    "plugins": [
      "@stryker-mutator/javascript",
      {
        "name": "@stryker-mutator/typescript",
        "excludedMutations": [
          "OptionalChaining",
          "NonNullAssertion"
        ]
      }
    ]
  },
  "tsconfigFile": "../tsconfig.json",
  "logLevel": "info",
  "fileLogLevel": "warn",
  "disableTypeChecks": false
}
